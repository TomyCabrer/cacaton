# Copy to .env (git-ignored) and fill in with YOUR OWN keys. No key ships with this repo.
# Without ANTHROPIC_API_KEY Copi replays the recorded Claude outputs in demo_cache/,
# and runs on rules only where nothing is recorded.

# Claude, live mode. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Voice radio between pilot and tower (optional; also needs uv). Get a project at https://cloud.livekit.io
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Optional
# MEMORIA_MODEL=claude-opus-5-5    # Claude model for the replay console
# MEMORIA_EFFORT=low
# MEMORIA_OFFLINE=1                # ignore the key and replay the recorded outputs
